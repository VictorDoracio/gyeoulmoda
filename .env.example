# ============================================================
# Gyeoul Moda — exemplo de configuração
# Copie este arquivo para ".env" e ajuste se necessário.
# NÃO versione o ".env" (já está no .gitignore).
# ============================================================

# Banco de dados (MySQL/MariaDB do XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gyeoulmoda
DB_USER=root
DB_PASS=

# Aplicação
APP_ENV=development
APP_URL=http://localhost/gyeoulmoda
APP_TIMEZONE=America/Sao_Paulo

# Sessão (segundos) — 1800 = 30 minutos
SESSION_LIFETIME=1800